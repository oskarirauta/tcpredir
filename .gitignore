# Prerequisites
# Scoped to the build directory: a bare `*.d` also matches directories, and
# LuCI's acl.d / menu.d are directories.
objs/*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/
objs/*.o

#binaries
# Anchored: an unanchored `tcpredir` also matches any directory of that name,
# which silently swallowed luci/.../view/tcpredir/ - the app was ignored, and
# `git add -A` said nothing.
/tcpredir
