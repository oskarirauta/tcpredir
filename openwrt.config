# /etc/config/tcpredir
#
# Installed empty on purpose: a redirect starts listening the moment the
# service reads it, so a package must not ship one. Add your own, or use
# LuCI (Network -> Port redirects). tcpredir.uci.example in the source
# tree has a filled-in section to copy from.
#
# config redirect 'web'
#	option enabled '1'
#	option proto 'tcp'		# tcp | udp | both
#	option listen_ip '0.0.0.0'	# 0.0.0.0 = every interface
#	option listen_port '8080'
#	option target_ip '10.0.0.99'
#	option target_port '80'
#	option connect_timeout '10'	# seconds to reach the target
#	option idle_timeout '300'	# seconds a quiet connection is kept
#	option udp_timeout '5'		# udp session lifetime, proto udp/both
#	option max_connections '128'
